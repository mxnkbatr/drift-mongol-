# Local/server runtime only. Never commit a real DATABASE_URL.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
PORT=8080
HOST=0.0.0.0
# Optional read-only maintenance mode for the leaderboard API.
GAME_LEADERBOARD_READ_ONLY=0
# Backend origins allowed to call the API. Keep capacitor://localhost for the iOS bundle.
GAME_CORS_ORIGINS=capacitor://localhost
# Frontend build-time origin for a Capacitor bundle; leave empty for same-origin web hosting.
VITE_API_BASE_URL=
