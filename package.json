{
  "name": "driftking",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "manus:build-source": "tsc --noEmit && vite build && node scripts/check-size.mjs",
    "appflow:build": "npm run build",
    "ionic:build": "npm run build",
    "manus:build": "node scripts/manus-game-assets/restore.mjs && node scripts/manus-game-sharing/build.mjs",
    "cap:sync": "npm run build && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "qrcode-generator": "1.4.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
