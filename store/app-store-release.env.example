# Backend/server secrets — configure in Manus or the server host only.
# Never commit a real value and never bundle this into the iOS app.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
PORT=8080
HOST=0.0.0.0
GAME_LEADERBOARD_READ_ONLY=0
GAME_CORS_ORIGINS=capacitor://localhost

# Production frontend build variable for the Capacitor bundle.
# Set this to the published Manus game origin, without a trailing slash.
VITE_API_BASE_URL=https://YOUR-PUBLISHED-GAME-DOMAIN

# iOS/Capacitor project identifiers — non-secret build metadata.
CAPACITOR_APP_NAME=Drift King: Steppe Neon
CAPACITOR_APP_ID=mn.driftking.steppe
IOS_BUNDLE_ID=mn.driftking.steppe
IOS_MIN_VERSION=15.0
IOS_ORIENTATION=landscape

# Optional CI/App Store Connect values: fill only in CI secret storage.
# APPLE_TEAM_ID=<Apple Developer Team ID>
# APPLE_APP_STORE_CONNECT_KEY_ID=<App Store Connect API Key ID>
# APPLE_ISSUER_ID=<App Store Connect API Issuer ID>
# APPLE_PRIVATE_KEY_PATH=<CI-only secret file path>
